# Copy to .env and adjust. Never commit .env.
ROOT_PATH=/pretty-print
DB_PATH=data/pretty-print.db

# Browser Use cloud key for fetch-use (offloads the fetch to their infra).
# Get one at https://cloud.browser-use.com. Empty = direct httpx fallback.
BROWSER_USE_API_KEY=

# simplified (HTML, noise stripped) | raw | markdown | structured
BROWSER_USE_OUTPUT_FORMAT=simplified
FETCH_TIMEOUT_MS=30000

# Last-resort backend for JS-heavy pages (needs playwright + chromium). Default off.
FETCH_ALLOW_HEADLESS=false

# Outer bound on the whole fetch sequence (seconds).
FETCH_SEQUENCE_TIMEOUT=90

# Per-IP cap on POST /print, enforced over the trailing window below.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60